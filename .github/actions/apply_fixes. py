#!/usr/bin/env python3
import os
import re

def main():
    response_file = '/tmp/response.txt'
    changes_file = '/tmp/changed.txt'
    if not os.path.isfile(response_file):
        print('No response file')
        return
    with open(response_file, 'r') as f:
        response = f.read()
    pattern = r'```\w*\s*(\S+\.[a-z]+)\n(.*?)```'
    matches = re.findall(pattern, response, re.DOTALL)
    changed = []
    for filepath, content in matches:
        filepath = filepath.strip().strip('/').lstrip('.')
        if '/' not in filepath or len(filepath) < 5:
            continue
        try:
            dir_path = os.path.dirname(filepath)
            if dir_path:
                os.makedirs(dir_path, exist_ok=True)
            with open(filepath, 'w') as f:
                f.write(content)
            changed.append(filepath)
        except Exception as e:
            print(f'Failed: {filepath} - {e}')
    with open(changes_file, 'w') as f:
        f.write('\n'.join(changed))
    print(f'Wrote {len(changed)} files')

if __name__ == '__main__':
    main()
